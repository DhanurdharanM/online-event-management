# ---- Server ----
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/convene
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Comma separated list of allowed front-end origins (first one is used for payment redirects)
CLIENT_URL=http://localhost:5173

# ---- Payments (Stripe Checkout: cards + wallets such as Google Pay / Apple Pay / Link) ----
# Leave STRIPE_SECRET_KEY empty to use the built-in demo gateway (no real money, great for local testing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CURRENCY=usd

# ---- Email (leave SMTP_HOST empty to just log emails to the console) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Convene <no-reply@convene.local>"
